# ========== 方向光照设置 ==========
directional_lighting_rot_x,-45          # 主方向光X轴旋转角度（度）
directional_lighting_rot_y,45           # 主方向光Y轴旋转角度（度）
directional_lighting_rot_z,0            # 主方向光Z轴旋转角度（度）
directional_lighting_color_r,0.844      # 主方向光颜色 - 红色分量（0-1）
directional_lighting_color_g,0.921      # 主方向光颜色 - 绿色分量（0-1）
directional_lighting_color_b,1          # 主方向光颜色 - 蓝色分量（0-1）
directional_lighting_intensity,3.14     # 主方向光强度值

# ========== 基于图像的光照(IBL) ==========
ibl_lighting_intensity,1                # IBL环境光照强度

# ========== 阴影设置 ==========
shadowing_color_r,0.097                 # 阴影颜色 - 红色分量
shadowing_color_g,0.1                   # 阴影颜色 - 绿色分量
shadowing_color_b,0.1                   # 阴影颜色 - 蓝色分量
shadow_frustum_width_half,600           # 阴影视锥体宽度的一半
shadow_frustum_depth_half,600           # 阴影视锥体深度的一半

# ========== 雾效设置 ==========
fog_rgb_boost,1                         # 雾效RGB颜色增强倍数
fog_alpha_boost,1                       # 雾效透明度增强倍数
fog_zenith_length,0                     # 天顶雾效长度（禁用）
fog_horizon_length,1                    # 地平线雾效长度

# ========== 地图雾效设置 ==========
mapfog_width,10000                      # 地图雾效宽度范围
mapfog_height,10000                     # 地图雾效高度范围
mapfog_center_x,0                       # 地图雾效中心X坐标
mapfog_center_y,0                       # 地图雾效中心Y坐标
mapfog_atten_start,0                    # 地图雾效衰减开始距离
mapfog_atten_end,1                      # 地图雾效衰减结束距离
# ========== Yebis后处理系统 ==========
yebis_able,1                            # 启用Yebis后处理系统 (1=启用, 0=禁用)
yebis_tonemap_exposure,1.4              # 色调映射曝光度
yebis_tonemap_gamma,1                   # 色调映射伽马值
yebis_glare_shape,1                     # 眩光形状参数
yebis_glare_luminance,1                 # 眩光亮度
yebis_glare_threshold,1                 # 眩光阈值
yebis_glare_remap_factor,1              # 眩光重映射因子

# ========== 光束效果设置 ==========
light_shaft_able,0                     # 启用光束效果 (1=启用, 0=禁用)
light_shaft_l_color_r,2.272            # 光束大光圈颜色 - 红色分量
light_shaft_l_color_g,3.336            # 光束大光圈颜色 - 绿色分量
light_shaft_l_color_b,8.098            # 光束大光圈颜色 - 蓝色分量
light_shaft_s_color_r,18.241           # 光束小光圈颜色 - 红色分量
light_shaft_s_color_g,14.304           # 光束小光圈颜色 - 绿色分量
light_shaft_s_color_b,16.712           # 光束小光圈颜色 - 蓝色分量
light_shaft_length,0.23                # 光束长度
light_shaft_glare_ratio,0              # 光束眩光比例
light_shaft_mask_depth_threshold,652.375  # 光束遮罩深度阈值
light_shaft_angle_attenuation,1        # 光束角度衰减
light_shaft_noise_mask,0               # 光束噪声遮罩
light_shaft_noise_frequency,0          # 光束噪声频率

# ------ 光束衍射环效果 ------
light_shaft_diffraction_ring,0.262     # 衍射环强度
light_shaft_diffraction_ring_radis,78.495  # 衍射环半径
light_shaft_diffraction_ring_attenuation,0.614  # 衍射环衰减
light_shaft_diffraction_ring_spectrum_order,0   # 衍射环光谱序号
light_shaft_diffraction_ring_outer_color_r,0.1  # 衍射环外圈颜色 - 红色分量
light_shaft_diffraction_ring_outer_color_g,0.1  # 衍射环外圈颜色 - 绿色分量
light_shaft_diffraction_ring_outer_color_b,0.1  # 衍射环外圈颜色 - 蓝色分量
# ========== 颜色校正设置 ==========
color_correct_contrast_r,1             # 颜色校正对比度 - 红色通道
color_correct_contrast_g,1             # 颜色校正对比度 - 绿色通道
color_correct_contrast_b,1             # 颜色校正对比度 - 蓝色通道
color_correct_hue,0                    # 颜色校正色相偏移
color_correct_saturate_r,1             # 颜色校正饱和度 - 红色通道
color_correct_saturate_g,1             # 颜色校正饱和度 - 绿色通道
color_correct_saturate_b,1             # 颜色校正饱和度 - 蓝色通道
color_correct_brightness,1             # 颜色校正亮度
color_correct_bias_r,0                 # 颜色校正偏移 - 红色通道
color_correct_bias_g,0                 # 颜色校正偏移 - 绿色通道
color_correct_bias_b,0                 # 颜色校正偏移 - 蓝色通道
color_correct_bias_norm_factor,1       # 颜色校正偏移标准化因子
color_correct_scale_r,1                # 颜色校正缩放 - 红色通道
color_correct_scale_g,1                # 颜色校正缩放 - 绿色通道
color_correct_scale_b,1                # 颜色校正缩放 - 蓝色通道

# ========== 景深效果设置 ==========
depth_field_able,0                     # 启用景深效果 (1=启用, 0=禁用)
depth_field_auto_focus,0               # 自动对焦 (1=启用, 0=禁用)
depth_field_focus_distance,20          # 对焦距离
depth_field_aperture_diameter,1        # 光圈直径

# ========== 特效环境设置 ==========
effect_ground_color_r,0.777            # 地面特效颜色 - 红色分量
effect_ground_color_g,0.778            # 地面特效颜色 - 绿色分量
effect_ground_color_b,0.779            # 地面特效颜色 - 蓝色分量
effect_offset_lighting_color_r,0       # 偏移光照颜色 - 红色分量
effect_offset_lighting_color_g,0       # 偏移光照颜色 - 绿色分量
effect_offset_lighting_color_b,0       # 偏移光照颜色 - 蓝色分量
effect_offset_lighting_intensity,0     # 偏移光照强度

# ------ 风力特效 ------
effect_wind_velocity_x,1               # 风力速度X方向分量
effect_wind_velocity_y,0               # 风力速度Y方向分量
effect_wind_velocity_z,0               # 风力速度Z方向分量

# ========== 边界设置 ==========
border_able,1                          # 启用边界功能 (1=启用, 0=禁用)
border_grid_num_x,6                    # 边界网格X方向数量
border_grid_num_y,6                    # 边界网格Y方向数量
border_offset_x,0                      # 边界X轴偏移
border_offset_y,0                      # 边界Y轴偏移
