{
  "productName": "EXVS Mod Project",
  "version": "0.1.0",
  "identifier": "com.kjjkjjzyayufqza.exvsmod",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6531",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EXVS Mod Project",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**"
          ]
        }
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../tools/**/*": "./tools/"
    },
    "createUpdaterArtifacts": true
  },
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NzM2N0NCQkQzNzVGQzkKUldUSlh6ZTl5MmR6YWJVaWJzbnhaeUZ4WWNILzRPT1l2K0lmYmpNSmtRREVLaDhyVlBoVmtqeCsK",
      "endpoints": [
        "https://github.com/kjjkjjzyayufqza/exvs-mod-project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
