# ========== 方向光照设置 ==========
directional_lighting_rot_x,-43.014          # 主方向光X轴旋转角度（度）
directional_lighting_rot_y,92               # 主方向光Y轴旋转角度（度）
directional_lighting_rot_z,0                # 主方向光Z轴旋转角度（度）
directional_lighting_color_r,1              # 主方向光颜色 - 红色分量（0-1）
directional_lighting_color_g,1              # 主方向光颜色 - 绿色分量（0-1）
directional_lighting_color_b,0.95           # 主方向光颜色 - 蓝色分量（0-1）
directional_lighting_intensity,4            # 主方向光强度值

# ========== 阴影设置 ==========
shadow_frustum_width_half,500               # 阴影视锥体宽度的一半
shadow_frustum_depth_half,500               # 阴影视锥体深度的一半
shadow_culling_far,600                      # 阴影远距离裁剪
shadow_tessellation_per_texel,32            # 每个纹理像素的细分数量
shadow_protected_radius,25                  # 阴影保护半径
shadow_saturation_radius,500                # 阴影饱和半径
shadow_importance_x,0                       # 阴影重要性X坐标
shadow_importance_y,0                       # 阴影重要性Y坐标
shadow_importance_z,0                       # 阴影重要性Z坐标

# ========== 雾效设置 ==========
fog_rgb_boost,1                             # 雾效RGB颜色增强倍数
fog_alpha_boost,1                           # 雾效透明度增强倍数
fog_zenith_length,0                         # 天顶雾效长度
fog_zenith_ratio_power,0.01                 # 天顶雾效比例幂次
fog_horizon_length,0                        # 地平线雾效长度

# ========== 地图雾效设置 ==========
mapfog_width,10000                          # 地图雾效宽度范围
mapfog_height,10000                         # 地图雾效高度范围
mapfog_center_x,0                           # 地图雾效中心X坐标
mapfog_center_y,0                           # 地图雾效中心Y坐标
mapfog_atten_start,0                        # 地图雾效衰减开始距离
mapfog_atten_end,0.82                       # 地图雾效衰减结束距离

# ========== Yebis后处理效果设置 ==========
yebis_able,1                                # 启用Yebis后处理 (1=启用, 0=禁用)
yebis_tonemap_type,3                        # 色调映射类型
yebis_tonemap_exposure,1.3                  # 色调映射曝光度
yebis_tonemap_gamma,0.9                     # 色调映射伽马值
yebis_tonemap_filmiccontrast,0.4            # 胶片风格对比度
yebis_glare_shape,1                         # 眩光形状
yebis_glare_luminance,1                     # 眩光亮度
yebis_glare_threshold,1                     # 眩光阈值
yebis_glare_remap_factor,1                  # 眩光重映射因子

# ========== 光束效果设置 ==========
light_shaft_able,1                          # 启用光束效果 (1=启用, 0=禁用)
light_shaft_l_color_r,1.9                   # 光束L颜色 - 红色分量
light_shaft_l_color_g,1.8                   # 光束L颜色 - 绿色分量
light_shaft_l_color_b,1                     # 光束L颜色 - 蓝色分量
light_shaft_s_color_r,30.446                # 光束S颜色 - 红色分量
light_shaft_s_color_g,36.877                # 光束S颜色 - 绿色分量
light_shaft_s_color_b,82.808                # 光束S颜色 - 蓝色分量
light_shaft_length,3.36                     # 光束长度
light_shaft_glare_ratio,0                   # 光束眩光比例
light_shaft_mask_depth_threshold,5000       # 光束遮罩深度阈值
light_shaft_angle_attenuation,58.8          # 光束角度衰减
light_shaft_noise_mask,0                    # 光束噪声遮罩
light_shaft_noise_frequency,0               # 光束噪声频率
light_shaft_diffraction_ring,0.345          # 光束衍射环强度
light_shaft_diffraction_ring_radis,0        # 光束衍射环半径
light_shaft_diffraction_ring_attenuation,0.041  # 光束衍射环衰减
light_shaft_diffraction_ring_spectrum_order,0.685  # 光束衍射环光谱顺序
light_shaft_diffraction_ring_outer_color_r,0.25    # 光束衍射环外部颜色 - 红色分量
light_shaft_diffraction_ring_outer_color_g,0.35    # 光束衍射环外部颜色 - 绿色分量
light_shaft_diffraction_ring_outer_color_b,0.2     # 光束衍射环外部颜色 - 蓝色分量
light_shaft_direction_attenuation_start,0.1        # 光束方向衰减开始值
light_shaft_direction_attenuation_end,-0.1         # 光束方向衰减结束值

# ========== 颜色校正设置 ==========
color_correct_contrast_r,1                  # 颜色校正对比度 - 红色分量
color_correct_contrast_g,1                  # 颜色校正对比度 - 绿色分量
color_correct_contrast_b,1                  # 颜色校正对比度 - 蓝色分量
color_correct_hue,0                         # 颜色校正色调偏移
color_correct_saturate_r,1                  # 颜色校正饱和度 - 红色分量
color_correct_saturate_g,1                  # 颜色校正饱和度 - 绿色分量
color_correct_saturate_b,1                  # 颜色校正饱和度 - 蓝色分量
color_correct_brightness,1                  # 颜色校正亮度
color_correct_bias_r,0                      # 颜色校正偏置 - 红色分量
color_correct_bias_g,0                      # 颜色校正偏置 - 绿色分量
color_correct_bias_b,0                      # 颜色校正偏置 - 蓝色分量
color_correct_bias_norm_factor,1            # 颜色校正偏置归一化因子
color_correct_scale_r,1.1                   # 颜色校正缩放 - 红色分量
color_correct_scale_g,0.95                  # 颜色校正缩放 - 绿色分量
color_correct_scale_b,0.95                  # 颜色校正缩放 - 蓝色分量

# ========== 景深效果设置 ==========
depth_field_able,0                          # 启用景深效果 (1=启用, 0=禁用)
depth_field_auto_focus,0                    # 自动对焦 (1=启用, 0=禁用)
depth_field_focus_distance,0                # 对焦距离
depth_field_aperture_diameter,1             # 光圈直径

# ========== 特效环境设置 ==========
# ------ 地面特效颜色 ------
effect_ground_color_r,0.766                 # 地面特效颜色 - 红色分量
effect_ground_color_g,0.831                 # 地面特效颜色 - 绿色分量
effect_ground_color_b,0.83                  # 地面特效颜色 - 蓝色分量

# ------ 偏移光照特效 ------
effect_offset_lighting_color_r,-0.104       # 偏移光照颜色 - 红色分量
effect_offset_lighting_color_g,-0.049       # 偏移光照颜色 - 绿色分量
effect_offset_lighting_color_b,-0.008       # 偏移光照颜色 - 蓝色分量
effect_offset_lighting_intensity,0.381      # 偏移光照强度

# ------ 风力特效 ------
effect_wind_velocity_x,1.2                  # 风力速度X方向分量
effect_wind_velocity_y,1.44                 # 风力速度Y方向分量
effect_wind_velocity_z,0                    # 风力速度Z方向分量

# ------ 水面特效 ------
effect_water_height_offset,4                # 水面高度偏移
effect_water_velocity_x,0                   # 水面流动速度X方向
effect_water_velocity_z,-1                  # 水面流动速度Z方向

# ========== 边界设置 ==========
border_able,0                               # 启用边界功能 (1=启用, 0=禁用)
border_grid_num_x,6                         # 边界网格X方向数量
border_grid_num_y,6                         # 边界网格Y方向数量
border_offset_x,0                           # 边界X轴偏移
border_offset_y,0                           # 边界Y轴偏移
border_limit_y,1000                         # 边界Y轴限制高度

# ========== 颜色分级设置 ==========
color_grading_enable,0                      # 启用颜色分级 (1=启用, 0=禁用)
